# Appeal Pilot Environment Configuration

# Google Gemini API Key from Google AI Studio (required for live pipeline)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Primary Model Name (defaults to gemini-3.1-flash-lite)
# Note: Google AI Studio model names change and deprecate over time. Verify current available Flash model IDs at https://aistudio.google.com/
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional Fallback Model Name (used if primary model encounters 503 capacity or 429 quota errors)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Demo Mode: Set to "cached" for reproducible video recording without live API calls.
# When omitted or set to "live", samples use the live API with fallback to cached golden data on failure.
DEMO_MODE=cached

# Canonical site URL for metadataBase & social cards (defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Appeal Pilot Environment Configuration

# Google Gemini API Key from Google AI Studio (required for live pipeline)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (defaults to gemini-2.5-flash or current Flash model)
GEMINI_MODEL=gemini-2.5-flash

# Demo Mode: Set to "cached" for reproducible video recording without live API calls.
# When omitted or set to "live", samples use the live API with fallback to cached golden data on failure.
DEMO_MODE=cached
